{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@common/*": ["./common/*"],
      "@config/*": ["./config/*"],
      "@modules/*": ["./modules/*"],
      "@env/*": ["./config/env/*"],
      "@infra/*": ["./common/*"],
      "@database/*": ["./common/services/*"],
      "@auth/*": ["./common/strategies/*"],
      "@cache/*": ["./common/services/*"],
      "@http/*": ["./common/services/*"],
      "@controllers/*": ["./modules/http/controllers/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
