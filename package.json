{
  "name": "library",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=!@workspace/shared-types",
    "dev": "npm run shared-types:dev & turbo dev --filter=!@workspace/shared-types",
    "db:seed": "turbo db:seed --filter=!@workspace/shared-types",
    "lint": "turbo lint --filter=!@workspace/shared-types",
    "format": "turbo format --filter=!@workspace/shared-types",
    "typecheck": "turbo typecheck --filter=!@workspace/shared-types",
    "shared-types:dev": "npm --workspace @workspace/shared-types run watch",
    "shared-types:build": "npm --workspace @workspace/shared-types run compile"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
